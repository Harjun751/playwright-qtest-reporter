{
	"name": "playwright-qtest-reporter",
	"version": "0.1.0",
	"description": "A utility to pass information from playwright test runs to qtest via the qtest management API.",
	"type": "module",
	"main": "./dist/reporter/index.js",
	"exports": {
		".": {
			"types": "./dist/reporter/index.d.ts",
			"default": "./dist/reporter/index.js"
		}
	},
	"types": "./dist/reporter/index.d.ts",
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Harjun751/playwright-qtest-reporter"
	},
	"keywords": [
		"playwright",
		"qtest",
		"reporter",
		"test-automation",
		"tricentis"
	],
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "vitest run",
		"check": "biome check --write",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.1.2",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"loglevel": "^1.9.2",
		"strip-ansi": "^7.2.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@playwright/test": ">=1.30.0"
	}
}
